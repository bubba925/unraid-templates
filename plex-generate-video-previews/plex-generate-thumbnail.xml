<?xml version="1.0"?>
<Container version="2">
  <Name>Plex-Generate-Vid-Previews</Name>
  <Repository>stevezzau/media_preview_generator:latest</Repository>
  <Registry>https://github.com/stevezau/media_preview_generator</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/196688-supportbubbas-templates</Support>
  <Project>https://github.com/stevezau/media_preview_generator/tree/main</Project>
  <ReadMe/>
  <Overview>Container to use hw acceleration to generate plex/jellyfin/media thumbnails.</Overview>
  <Category>Tools:Utilities</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL/>
  <Icon>https://github.com/stevezau/media_preview_generator/blob/main/docs/images/icon.png?raw=true</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires/>
  <Config Name="Plex Config" Target="/plex" Default="" Mode="rw" Description="Plex Config" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Movies" Target="/data/movies" Default="" Mode="ro" Description="Movies folder" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="TV" Target="/data/tv" Default="" Mode="ro" Description="Tv folder" Type="Path" Display="always" Required="true" Mask="false">/</Config>
  <Config Name="GPU" Target="/dev/dri" Default="" Mode="" Description="GPU device" Type="Device" Display="always" Required="true" Mask="false">/dev/dri</Config>
  <Config Name="webui" Target="8080" Default="" Mode="tcp" Description="" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Thumbnail Gen Config" Target="/config" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID" Type="Variable" Display="always" Required="false" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID" Type="Variable" Display="always" Required="false" Mask="false">100</Config>
  <TailscaleStateDir/>
</Container>
