<?xml version="1.0"?>
<Container version="2">
  <Name>bookshelf</Name>
  <Repository>ghcr.io/pennydreadful/bookshelf:softcover</Repository>
  <Registry>https://github.com/pennydreadful/bookshelf</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://forums.unraid.net/topic/196688-supportbubbas-templates</Support>
  <Project>https://github.com/pennydreadful/bookshelf</Project>
  <ReadMe/>
  <Overview>Fork of Readarr, Arr For Books</Overview>
  <Category>MediaServer:Books</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <TemplateURL/>
  <Icon>https://github.com/pennydreadful/bookshelf/blob/develop/Logo/128.png?raw=true</Icon>
  <ExtraParams/>
  <PostArgs/>
  <CPUset/>
  <DateInstalled>1769110856</DateInstalled>
  <DonateText/>
  <DonateLink/>
  <Requires>tag must be changed from hardcover to softcover if coming from readarr to use goodreads metadata.</Requires>
  <Config Name="Webui" Target="8787" Default="8787" Mode="tcp" Description="Port to bookshelf web ui." Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="config" Target="/config" Default="/mnt/user/appdata/bookshelf/" Mode="rw" Description="Bookshelf config file." Type="Path" Display="always" Required="true" Mask="false"></Config>
  <Config Name="Downloads" Target="/downloads" Default="" Mode="rw" Description="Location of download client folder." Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="media" Target="/media" Default="" Mode="rw" Description="Location of audiobooks on disk." Type="Path" Display="always" Required="false" Mask="false"></Config>
  <Config Name="PUID" Target="PUID" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="PGID" Target="PGID" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="UMASK" Target="UMASK" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Metadata URL" Target="METADATA_URL" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false"/>
  <TailscaleStateDir/>
</Container>
